-- 5. ระบบเชื่อมต่อเสียงติดหัวตัวละคร (ทุกคนในเซิร์ฟได้ยินร่วมกัน)
local function GetServerSound()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
        local head = LocalPlayer.Character.Head
        local sound = head:FindFirstChild("PMHubBoombox")
        if not sound then
            sound = Instance.new("Sound")
            sound.Name = "PMHubBoombox"
            sound.Volume = 3
            sound.MaxDistance = 80
            sound.RollOffMode = Enum.RollOffMode.Linear
            sound.Looped = true
            sound.Parent = head
        end
        return sound
    end
    return nil
end

