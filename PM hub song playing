-- ระบบส่งสัญญาณเสียงไปที่ตัวละคร (Server Replicated คนอื่นได้ยิน)
local function GetServerSound()
    local player = game:GetService("Players").LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("Head") then
        local head = player.Character.Head
        local sound = head:FindFirstChild("ServerFunkBoombox")
        if not sound then
            sound = Instance.new("Sound")
            sound.Name = "ServerFunkBoombox"
            sound.Volume = 2
            sound.MaxDistance = 80
            sound.RollOffMode = Enum.RollOffMode.Linear
            sound.Looped = true
            sound.Parent = head
        end
        return sound
    end
    return nil
end

-- สร้างหน้า Play ขนาดเล็ก
local Tab = Window:CreateTab("🎧 Play", 4483362458)

-- เรียงรายชื่อเพลงตามตัวอักษร
local SongOptions = {}
for songName, _ in pairs(FunkPlaylist) do
    table.insert(SongOptions, songName)
end
table.sort(SongOptions)

-- Dropdown เลือกจาก 50 เพลงดัง
local MusicDropdown = Tab:CreateDropdown({
   Name = "🎵 เลือกเพลง (รวม 50 เพลงดัง)",
   Options = SongOptions,
   CurrentOption = {SongOptions},
   MultipleOptions = false,
   Callback = function(Option)
      local assetId = FunkPlaylist[Option]
      local sfx = GetServerSound()
      if assetId and sfx then
          sfx:Stop()
          sfx.SoundId = "rbxassetid://" .. assetId
          sfx:Play()
          Rayfield:Notify({Title = "PM hub", Content = "กำลังเล่น: " .. Option, Duration = 1}) -- Notification แบบสั้นกระชับ
      end
   end,
})

-- แผงควบคุมเสียง
