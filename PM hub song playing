   Name = "🔊 ความดัง",
   Range = {0, 10},
   Increment = 1,
   Suffix = "x",
   CurrentValue = 2,
   Callback = function(Value)
      local sfx = GetServerSound()
      if sfx then sfx.Volume = Value end
   end,
})

