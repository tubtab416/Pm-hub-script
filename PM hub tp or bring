local Rayfield = loadstring(game:HttpGet('https://sirius.menu'))()
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- สร้างหน้าต่างหลักของ PM hub
local Window = Rayfield:CreateWindow({
   Name = "PM hub",
   LoadingTitle = "PM hub Loading...",
   LoadingSubtitle = "Bypass Teleport Edition",
   ConfigurationSaving = { Enabled = false },
   Discord = { Enabled = false },
   KeySystem = false
})

-- สร้างแท็บเมนูหลัก
local MainTab = Window:CreateTab("TP & Bring", 4483362458)

local SelectedPlayers = {}
local TeleportMode = "Goto"
local LoopBringActive = false

-- 1. ดรอปดาวน์เลือกผู้เล่น (เลือกพร้อมกันได้หลายคน)
local PlayerDropdown = MainTab:CreateDropdown({
   Name = "เลือกผู้เล่น (Select Players)",
   Options = {},
   CurrentOption = {},
   MultipleOptions = true,
   Callback = function(Options) SelectedPlayers = Options end,
})

-- ฟังก์ชันอัปเดตรายชื่อในเซิร์ฟเวอร์
local function UpdateDropdown()
   local playerList = {}
   for _, player in pairs(Players:GetPlayers()) do
      if player ~= LocalPlayer then table.insert(playerList, player.Name) end
   end
   PlayerDropdown:Refresh(playerList)
end
Players.PlayerAdded:Connect(UpdateDropdown)
Players.PlayerRemoving:Connect(UpdateDropdown)
UpdateDropdown()

-- 2. ปุ่ม Select All
MainTab:CreateButton({
   Name = "Select All (เลือกทุกคน)",
   Callback = function()
      local allPlayers = {}
      for _, player in pairs(Players:GetPlayers()) do
         if player ~= LocalPlayer then table.insert(allPlayers, player.Name) end
      end
      PlayerDropdown:Set(allPlayers)
      SelectedPlayers = allPlayers
      Rayfield:Notify({Title = "PM hub", Content = "เลือกผู้เล่นทุกคนแล้ว", Duration = 2})
   end,
})

-- 3. ปุ่ม Unselect All
MainTab:CreateButton({
   Name = "Unselect All (ปลดเลือกทุกคน)",
   Callback = function()
      PlayerDropdown:Set({})
      SelectedPlayers = {}
      Rayfield:Notify({Title = "PM hub", Content = "ปลดการเลือกทั้งหมดแล้ว", Duration = 2})
   end,
})

-- 4. เลือกโหมดการทำงาน
MainTab:CreateDropdown({
   Name = "เลือกโหมดการทำงาน (Select Mode)",
   Options = {"Goto (Bypass ไม่เด้งกลับ)", "Bring (Bypass ลากตัว)"},
   CurrentOption = {"Goto (Bypass ไม่เด้งกลับ)"},
   MultipleOptions = false,
   Callback = function(Option)
      if Option == "Goto (Bypass ไม่เด้งกลับ)" then
         TeleportMode = "Goto"
      else
         TeleportMode = "Bring"
      end
   end,
})

-- 5. 🟢 ปุ่มสีเขียวสำหรับรันการทำงาน (START TELEPORT)
MainTab:CreateButton({
   Name = "🟢 START TELEPORT (BYPASS) 🟢",
   Callback = function()
      local myChar = LocalPlayer.Character
      local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
      
      if not myHRP then 
         Rayfield:Notify({Title = "PM hub Error", Content = "ไม่พบตัวละครของคุณ", Duration = 3})
         return 
      end

      local hasSelected = false
      for _, _ in pairs(SelectedPlayers) do hasSelected = true break end
      if not hasSelected then
         Rayfield:Notify({Title = "PM hub Warning", Content = "กรุณาเลือกผู้เล่นก่อนกดวาร์ป", Duration = 3})
         return
      end

      -- =====================================
      -- โหมด GOTO (วาร์ปไปหาแบบแก้ทางตัวดึงกลับ)
      -- =====================================
      if TeleportMode == "Goto" then
         for _, pName in pairs(SelectedPlayers) do
            local targetPlayer = Players:FindFirstChild(pName)
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
               
               -- หยุดแรงเฉื่อยทางฟิสิกส์ทั้งหมดเพื่อป้องกันเซิร์ฟเวอร์ดึงกลับ (Anti-Rubberband)
               myHRP.Velocity = Vector3.new(0, 0, 0)
               myHRP.RotVelocity = Vector3.new(0, 0, 0)
               
               -- วาร์ปไปตำแหน่งเหนือเป้าหมายเล็กน้อยเพื่อไม่ให้ตัวละครจมดินหรือติดโมเดล
               local targetCFrame = targetPlayer.Character.HumanoidRootPart.CFrame
               myHRP.CFrame = targetCFrame + Vector3.new(0, 2, 0)
               
               task.wait(0.05)
               myHRP.Velocity = Vector3.new(0, 0, 0) -- ล้างความเร็วซ้ำอีกครั้ง
               
               Rayfield:Notify({Title = "PM hub", Content = "วาร์ปไปหา @" .. pName .. " สำเร็จ", Duration = 2})
               break
            end
         end

      -- =====================================
      -- โหมด BRING (ดึงคนอื่นแบบแย่งสิทธิ์ฟิสิกส์)
      -- =====================================
      elseif TeleportMode == "Bring" then
         LoopBringActive = true
         Rayfield:Notify({Title = "PM hub", Content = "กำลังดึงตัวด้วยระบบฟิสิกส์ลากจูง...", Duration = 3})
         
         local originalPos = myHRP.CFrame
         
         task.spawn(function()
            -- วนลูปสลับตำแหน่งอย่างรวดเร็วเพื่อให้เซิร์ฟเวอร์รับตำแหน่งปลายทาง
            for i = 1, 15 do 
               if not LoopBringActive then break end
               for _, pName in pairs(SelectedPlayers) do
                  local targetPlayer = Players:FindFirstChild(pName)
                  if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                     
                     -- วาร์ปตัวเราไปชนเป้าหมายเพื่อเคลียร์ Network Ownership ชั่วคราว
                     myHRP.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame
                     task.wait(0.01)
                     
                     -- ลากตัวเป้าหมายและตัวเรากลับมาที่จุดเดิม
                     targetPlayer.Character.HumanoidRootPart.CFrame = originalPos
                     myHRP.CFrame = originalPos
                  end
               end
               task.wait(0.02)
            end
            LoopBringActive = false
            Rayfield:Notify({Title = "PM hub", Content = "สิ้นสุดกระบวนการดึงตัว", Duration = 2})
         end)
      end
   end,
})

-- ปุ่มฉุกเฉินกรณีระบบลูปค้างหรือตัวละครติดบั๊ก
MainTab:CreateButton({
   Name = "❌ STOP ALL LOOP (หยุดระบบวาร์ปค้าง) ❌",
   Callback = function()
      LoopBringActive = false
      Rayfield:Notify({Title = "PM hub", Content = "หยุดระบบวาร์ปค้างทั้งหมดแล้ว", Duration = 2})
   end,
})
