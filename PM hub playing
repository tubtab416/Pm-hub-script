local function play(p)
    local c={"ค้อน","กรรไกร","กระดาษ"}
    local a=c[math.random(1,3)]
    local r=(p==a) and "เสมอ" or ((p=="ค้อน" and a=="กรรไกร") or (p=="กรรไกร" and a=="กระดาษ") or (p=="กระดาษ" and a=="ค้อน")) and "ชนะ" or "แพ้"
    if r=="ชนะ" then ps=ps+1 elseif r=="แพ้" then as=as+1 end
    L1.Text="คะแนนของคุณ: "..ps
    L2.Text="คะแนนของ AI: "..as
    L3.Text="ล่าสุด: คุณ ["..p.."] vs AI ["..a.."] -> "..r
end

