local function move(m)
    if not car or not car:FindFirstChild("BodyVelocity") then return end
    local s=ib and 80 or 25
    if m=="F" then car.BodyVelocity.Velocity=car.CFrame.LookVector*s
    elseif m=="B" then car.BodyVelocity.Velocity=car.CFrame.LookVector*-s
    elseif m=="L" then car.BodyAngularVelocity.AngularVelocity=Vector3.new(0,4,0)
    elseif m=="R" then car.BodyAngularVelocity.AngularVelocity=Vector3.new(0,-4,0)
    elseif m=="SM" then car.BodyVelocity.Velocity=Vector3.new(0,0,0)
    elseif m=="ST" then car.BodyAngularVelocity.AngularVelocity=Vector3.new(0,0,0) end
end

local function spawnC()
    if car then car:Destroy() end
    local h=G.Players.LocalPlayer.Character.HumanoidRootPart
    car=Instance.new("Part",workspace)
    car.Name="PMCar";car.Size=Vector3.new(4,0.4,5)
    car.Position=h.Position+h.CFrame.LookVector*6
    car.Material="Neon";car.CanCollide=false
    local s=Instance.new("VehicleSeat",workspace)
    s.Size=Vector3.new(3,1,3);s.Position=car.Position+Vector3.new(0,0.5,0)
    s.Transparency=0.8;s.CanCollide=true
    local w=Instance.new("WeldConstraint",car)
    w.Part0=car;w.Part1=s
    local a=Instance.new("WedgePart",car)
    a.Size=Vector3.new(1.5,1,1.5)
    a.Color=Color3.fromRGB(0,255,100)
    a.CFrame=car.CFrame*CFrame.new(0,0.6,-1.75)*CFrame.Angles(0,math.rad(180),0)
    local w2=Instance.new("WeldConstraint",car)
    w2.Part0=car;w2.Part1=a
    local bv=Instance.new("BodyVelocity",car)
    bv.MaxForce=Vector3.new(1,0,1)*1e6
    local ba=Instance.new("BodyAngularVelocity",car)
    ba.MaxTorque=Vector3.new(0,1,0)*1e6
    task.spawn(function()
        local hc=0
        while car and car.Parent do car.Color=Color3.fromHSV(hc,1,1);s.Color=car.Color;hc=(hc+0.02)%1;task.wait(0.04) end
    end)
end

local function flip()
    if not car then return end
    car.BodyVelocity.Velocity=Vector3.new(0,0,0)
    car.BodyAngularVelocity.AngularVelocity=Vector3.new(0,0,0)
    local y=math.atan2(-car.CFrame.LookVector.X,-car.CFrame.LookVector.Z)
    car.CFrame=CFrame.new(car.Position+Vector3.new(0,3,0))*CFrame.Angles(0,y,0)
end

