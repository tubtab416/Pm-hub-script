-- โหลด Rayfield UI Library เวอร์ชันทางการ
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- สร้างหน้าต่างหลัก PM hub admin
local Window = Rayfield:CreateWindow({
   Name = "👑 PM hub admin",
   LoadingTitle = "PM hub admin",
   LoadingSubtitle = "Mobile Edition",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

-- ตัวแปรระบบและการตั้งค่าเริ่มต้น
local player = game.Players.LocalPlayer
local camera = workspace.CurrentCamera
local targetName = ""
local walkSpeed = 16
local jumpPower = 50
local flySpeed = 50
local loopStatsEnabled = false
local espEnabled = false
local aimbotEnabled = false
local flying = false
local noclip = false

-- ฟังก์ชันค้นหาผู้เล่นจากชื่อบางส่วน
local function GetTargetPlayer(name)
   name = name:lower()
   for _, p in pairs(game.Players:GetPlayers()) do
      if p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name then
         return p
      end
   end
   return nil
end

-- สร้างแท็บต่าง ๆ
local MainTab = Window:CreateTab("🏠 หน้าแรก")
local TargetTab = Window:CreateTab("🎯 จัดการผู้เล่น")
local PlayerTab = Window:CreateTab("⚡ ตัวละคร")
local CombatTab = Window:CreateTab("👁️ ช่วยเล่น")
local OwnerTab = Window:CreateTab("🔥 พิเศษ")

-- [แท็บ: หน้าแรก]
MainTab:CreateParagraph({Title = "PM hub admin", Content = "ระบบควบคุมผู้ดูแลระบบเวอร์ชันมือถือ"})

-- [แท็บ: จัดการผู้เล่น]
TargetTab:CreateInput({
   Name = "พิมพ์ชื่อผู้เล่นเป้าหมาย",
   PlaceholderText = "ระบุชื่อตรงนี้...",
   RemoveTextAfterFocusLost = false,
   Callback = function(text) targetName = text end
})

TargetTab:CreateButton({
   Name = "💀 สั่งฆ่า (Kill Player)",
   Callback = function()
      local p = GetTargetPlayer(targetName)
      if p and p.Character and p.Character:FindFirstChild("Humanoid") then
         p.Character.Humanoid.Health = 0
      end
   end
})

TargetTab:CreateButton({
   Name = "🥶 แช่แข็ง / ปลดแช่แข็ง (Freeze Toggle)",
   Callback = function()
      local p = GetTargetPlayer(targetName)
      if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
         local hrp = p.Character.HumanoidRootPart
         hrp.Anchored = not hrp.Anchored
         Rayfield:Notify({Title = "PM Admin", Content = hrp.Anchored and "แช่แข็งแล้ว" or "ปลดแช่แข็งแล้ว", Duration = 2})
      end
   end
})

-- [แท็บ: ตัวละคร]
PlayerTab:CreateSlider({
   Name = "ความเร็วเดิน (WalkSpeed)",
   Range = {16, 500},
   Increment = 1,
   CurrentValue = 16,
   Callback = function(v)
      walkSpeed = v
      pcall(function() player.Character.Humanoid.WalkSpeed = v end)
   end
})

PlayerTab:CreateSlider({
   Name = "แรงกระโดด (JumpPower)",
   Range = {50, 1000},
   Increment = 1,
   CurrentValue = 50,
   Callback = function(v)
      jumpPower = v
      pcall(function() player.Character.Humanoid.JumpPower = v end)
   end
})

PlayerTab:CreateToggle({
   Name = "ล็อกค่าพลัง (Loop Stats)",
   CurrentValue = false,
   Callback = function(v)
      loopStatsEnabled = v
      task.spawn(function()
         while loopStatsEnabled do
            pcall(function()
               if player.Character and player.Character:FindFirstChild("Humanoid") then
                  player.Character.Humanoid.WalkSpeed = walkSpeed
                  player.Character.Humanoid.JumpPower = jumpPower
               end
            end)
            task.wait(1)
         end
      end)
   end
})

-- [แท็บ: ช่วยเล่น - ESP & Aimbot]
local function ApplyESP(p)
   if p == player then return end
   local function addHighlight(char)
      if not char:FindFirstChild("PM_E") then
         local hl = Instance.new("Highlight")
         hl.Name = "PM_E"
         hl.FillColor = Color3.fromRGB(255, 0, 0)
         hl.FillTransparency = 0.5
         hl.Parent = char
      end
   end
   if p.Character then addHighlight(p.Character) end
   p.CharacterAdded:Connect(addHighlight)
end

CombatTab:CreateToggle({
   Name = "เปิดระบบ ESP มองทะลุ",
   CurrentValue = false,
   Callback = function(v)
      espEnabled = v
      if espEnabled then
         for _, p in pairs(game.Players:GetPlayers()) do ApplyESP(p) end
         game.Players.PlayerAdded:Connect(ApplyESP)
      else
         for _, p in pairs(game.Players:GetPlayers()) do
            pcall(function() p.Character.PM_E:Destroy() end)
         end
      end
   end
})

CombatTab:CreateToggle({
   Name = "เปิดระบบ Aimbot ล็อกเป้า",
   CurrentValue = false,
   Callback = function(v)
      aimbotEnabled = v
      task.spawn(function()
         while aimbotEnabled do
            local closestPlayer = nil
            local shortestDistance = math.huge
            for _, p in pairs(game.Players:GetPlayers()) do
               if p ~= player and p.Character and p.Character:FindFirstChild("Head") and p.Character.Humanoid.Health > 0 then
                  local pos, onScreen = camera:WorldToViewportPoint(p.Character.Head.Position)
                  if onScreen then
                     local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)).Magnitude
                     if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = p
                     end
                  end
               end
            end
            if closestPlayer then
               camera.CFrame = CFrame.new(camera.CFrame.Position, closestPlayer.Character.Head.Position)
            end
            task.wait()
         end
      end)
   end
})

-- [แท็บ: พิเศษ - Fly & Noclip]
OwnerTab:CreateToggle({
   Name = "เปิดระบบบิน (Fly Mode)",
   CurrentValue = false,
   Callback = function(v)
      flying = v
      local hrp = player.Character:WaitForChild("HumanoidRootPart")
      if flying then
         local bv = Instance.new("BodyVelocity", hrp)
         local bg = Instance.new("BodyGyro", hrp)
         bv.Name, bg.Name = "PM_B", "PM_G"
         bv.maxForce = Vector3.new(4e5, 4e5, 4e5)
         bg.maxTorque = Vector3.new(4e5, 4e5, 4e5)
         
         task.spawn(function()
            while flying do
               pcall(function()
                  bg.cframe = camera.CFrame
                  if player.Character.Humanoid.MoveDirection.Magnitude > 0 then
                     bv.velocity = camera.CFrame.LookVector * flySpeed
                  else
                     bv.velocity = Vector3.new(0, 0.1, 0)
                  end
               end)
               task.wait()
            end
            pcall(function() hrp.PM_B:Destroy() hrp.PM_G:Destroy() end)
         end)
      else
         pcall(function() hrp.PM_B:Destroy() hrp.PM_G:Destroy() end)
      end
   end
})

OwnerTab:CreateSlider({
   Name = "ความเร็วบิน (Fly Speed)",
   Range = {10, 300},
   Increment = 5,
   CurrentValue = 50,
   Callback = function(v) flySpeed = v end
})

OwnerTab:CreateToggle({
   Name = "เดินทะลุกำแพง (Noclip)",
   CurrentValue = false,
   Callback = function(v)
      noclip = v
      game:GetService("RunService").Stepped:Connect(function()
         if noclip then
            pcall(function()
               for _, part in pairs(player.Character:GetChildren()) do
                  if part:IsA("BasePart") then part.CanCollide = false end
               end
            end)
         end
      end)
   end
})

