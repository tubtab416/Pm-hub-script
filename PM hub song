-- ฟังค์ชันสร้างหรือดึงเสียงที่หัวตัวละคร (ทุกคนได้ยิน)
local function GetServerSound()
    local player = game:GetService("Players").LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("Head") then
        local head = player.Character.Head
        local sound = head:FindFirstChild("PMHubBoombox")
        if not sound then
            sound = Instance.new("Sound")
            sound.Name = "PMHubBoombox"
            sound.Volume = 2
            sound.MaxDistance = 80
            sound.RollOffMode = Enum.RollOffMode.Linear
            sound.Looped = true
            sound.Parent = head
        end
        return sound
    end
    return nil
end

-- ฟังค์ชันหยุดเพลงสากล (หยุดทุกภาษา)
local function StopAllMusic()
    local sfx = GetServerSound()
    if sfx then
        sfx:Stop()
        Rayfield:Notify({Title = "PM hub", Content = "🛑 หยุดเพลงทั้งหมดแล้ว", Duration = 1})
    end
end

