-- คำสั่งสั่งสไลด์ขึ้น/ลง เมื่อกดย่อหน้าต่าง
MiniBtn.MouseButton1Click:Connect(function()
    local frameTweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    if not IsMinimized then
        -- จังหวะกดย่อ: สไลด์แถบด้านล่างขึ้นไปซ่อนด้านบน และหดความสูงหน้าต่างหลักเหลือแค่แถบ TopBar
        local shrinkFrame = TweenService:Create(MainFrame, frameTweenInfo, {Size = UDim2.new(0, 340, 0, 32)})
        local slideUp = TweenService:Create(ContentFrame, frameTweenInfo, {Position = UDim2.new(0, 0, 0, -180)})
        
        shrinkFrame:Play()
        slideUp:Play()
        MiniBtn.Text = "➕" -- เปลี่ยนไอคอนเป็นบวกเมื่อย่อเสร็จ
        IsMinimized = true
    else
        -- จังหวะกดขยาย: สไลด์แถบด้านล่างคลี่ตัวกลับมาที่เดิม และยืดขนาดหน้าต่างหลักเท่าเดิม
        local expandFrame = TweenService:Create(MainFrame, frameTweenInfo, {Size = UDim2.new(0, 340, 0, 210)})
        local slideDown = TweenService:Create(ContentFrame, frameTweenInfo, {Position = UDim2.new(0, 0, 0, 32)})
        
        expandFrame:Play()
        slideDown:Play()
        MiniBtn.Text = "➖" -- เปลี่ยนไอคอนเป็นลบเมื่อขยายเสร็จ
        IsMinimized = false
    end
end)

-- ระบบลากเมนูสำหรับมือถือ
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

