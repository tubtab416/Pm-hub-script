   Callback = function(Option)
      local chosen = type(Option) == "table" and Option[1] or Option
      local assetId = ThaiAudioIds[chosen] or "18432321473" 
      local sfx = GetServerSound()
      if sfx then
          sfx:Stop()
          sfx.SoundId = "rbxassetid://" .. assetId
          sfx:Play()
          Rayfield:Notify({Title = "PM hub", Content = "🇹🇭 เล่นเพลงไทย: " .. chosen, Duration = 1})
      end
   end,
})

ThaiTab:CreateButton({ Name = "🛑 หยุดเพลง (ทุกภาษา)", Callback = StopAllMusic })

