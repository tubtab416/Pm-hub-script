local ThaiTab = Window:CreateTab("🇹🇭 Thai Music", 4483362458)

local ThaiDropdown = ThaiTab:CreateDropdown({
   Name = "🎵 เลือกเพลงไทย (50 เพลง)",
   Options = ThaiPlaylist,
   CurrentOption = "💨 ยังเอพ่นควัน (YOUNGOHM)", -- แก้ไขให้เป็น String เดี่ยวเพื่อรองรับ Delta Mobile 
