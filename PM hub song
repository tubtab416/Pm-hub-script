-- ระบบเชื่อมต่อเสียง
local function GetSafeSound()
    local SoundService = game:GetService("SoundService")
    local sound = SoundService:FindFirstChild("PMHubBypassSound")
    if not sound then
        sound = Instance.new("Sound")
        sound.Name = "PMHubBypassSound"
        sound.Volume = 3
        sound.Looped = true
        sound.Parent = SoundService
    end
    return sound
end

